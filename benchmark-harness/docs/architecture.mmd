%%{init: {'theme':'dark'}}%%
flowchart LR
    classDef compute    fill:#7C5CFF,stroke:#5B3DD9,color:#F1F5F9,stroke-width:1px
    classDef hot        fill:#00C2A8,stroke:#008F7E,color:#0B1020,stroke-width:1px
    classDef warm       fill:#F2C744,stroke:#C99B0A,color:#0B1020,stroke-width:1px
    classDef container  fill:#94A3B8,stroke:#64748B,color:#0B1020,stroke-width:1px
    classDef fabric     fill:#1E293B,stroke:#64748B,color:#F1F5F9,stroke-width:1px,stroke-dasharray: 4 3

    %% ---- Main data flow (left → right) -------------------------------------
    %% Inputs (configuration / inert data → slate container)
    S["Scenario YAML"]:::container
    C["Campaign YAML"]:::container

    %% Execution — active computation (compute violet)
    subgraph EXE["Execution"]
        ORC["orchestrator.py<br>walks Campaign<br>resume-from-crash"]:::compute
        RUN["runners/fio.py<br>prepare → run_jobs → cleanup<br>prefill · drop_caches"]:::compute
    end

    %% Collection — parser (transformer / slate) feeds local hot store (teal)
    subgraph COL["Collection"]
        PAR["parsers/fio.py<br>JSON → MetricRecord"]:::container
        DB[("store.py<br>SQLite")]:::hot
    end

    %% Reporting — durable summary artifact (warm amber)
    subgraph REPORTING["Reporting"]
        REP["report.py<br>markdown tables<br>wrap detection"]:::warm
    end

    %% Output (final artifact → slate container)
    OUT["Markdown report<br>results/reports/&lt;run-id&gt;.md"]:::container

    %% ---- Foundation: called by Execution, not part of the data flow --------
    subgraph FOUNDATION["Automation foundation · called by Execution"]
        SSH["ssh.py<br>run_remote · df<br>preflight_target"]:::fabric
    end

    %% Data flow (solid arrows, left → right)
    S --> ORC
    C --> ORC
    ORC --> RUN
    RUN -- "fio JSON" --> PAR
    PAR --> DB
    DB --> REP
    REP --> OUT

    %% Service-call relationship (dashed "uses" arrows)
    ORC -. "uses" .-> SSH
    RUN -. "uses" .-> SSH
